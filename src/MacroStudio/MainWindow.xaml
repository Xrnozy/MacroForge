<Window x:Class="MacroStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Macro Studio" Width="600" SizeToContent="Height" MinWidth="600" MaxWidth="600" MinHeight="0" ResizeMode="CanResize" WindowStyle="None"
        FontFamily="Segoe UI" FontSize="12" Background="#F3F5F9">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid x:Name="Outer">
    <Border x:Name="Root" Background="#F3F5F9">
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="40" Background="White" BorderBrush="#E8EBF0" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinBtn" Style="{StaticResource Caption}" Content="&#xE921;" Tag="0" Click="Min_Click" ToolTip="Minimise"/>
                    <Button x:Name="MaxBtn" Style="{StaticResource Caption}" Content="&#xE922;" Tag="0" Click="Max_Click" Visibility="Collapsed" ToolTip="Maximise"/>
                    <Button x:Name="CloseBtn" Style="{StaticResource CaptionClose}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
                </StackPanel>
                <Ellipse DockPanel.Dock="Left" Width="11" Height="11" Fill="#EF4444" Margin="16,0,8,0" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="Macro Studio" FontSize="14" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center"/>
        <Menu DockPanel.Dock="Left" Background="Transparent" VerticalAlignment="Center" Margin="10,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <MenuItem Header="_File">
                <MenuItem Header="_New macro" Click="NewMacro_Click"/>
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="Save_Click"/>
                <Separator/>
                <MenuItem Header="_Import macro file..." Click="Import_Click"/>
                <MenuItem Header="_Export macro file..." Click="Export_Click"/>
                <MenuItem Header="Open library _folder" Click="OpenFolder_Click"/>
                <Separator/>
                <MenuItem Header="_Logs">
                    <MenuItem Header="Show the _run log (this session)" Click="ShowRunLog_Click" ToolTip="The step-by-step log of the last playback: what each step and each When block did"/>
                    <MenuItem Header="Open the last _playback log file" Click="OpenPlayLog_Click" ToolTip="Saved automatically when a playback ends: send this file when something does not run as expected"/>
                    <MenuItem Header="Open the last _recording log file" Click="OpenRecordLog_Click"/>
                    <MenuItem Header="Open the logs _folder" Click="OpenFolder_Click" ToolTip="Playback and recording logs are saved in the library folder"/>
                </MenuItem>
                <MenuItem Header="Restart as _administrator" Click="RestartAdmin_Click" ToolTip="Needed to record or play into programs that run as administrator (some games)"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
                <Separator/>
                <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Click="Copy_Click"/>
                <MenuItem Header="_Paste at playhead" InputGestureText="Ctrl+V" Click="Paste_Click"/>
                <MenuItem Header="D_uplicate" InputGestureText="Ctrl+D" Click="Duplicate_Click"/>
                <MenuItem Header="_Delete" InputGestureText="Del" Click="Delete_Click"/>
                <Separator/>
                <MenuItem Header="Select _all" InputGestureText="Ctrl+A" Click="SelectAll_Click"/>
                <MenuItem Header="_Trim idle time before first event" Click="Trim_Click"/>
                <Separator/>
                <MenuItem Header="Convert recorded click to adaptive _target click..." Click="ConvertClick_Click"/>
                <MenuItem Header="Toggle _breakpoint on selected event" InputGestureText="Ctrl+B" Click="Breakpoint_Click"/>
            </MenuItem>
            <MenuItem Header="_Insert at playhead">
                <MenuItem Header="Click target" Tag="TargetClick" SubmenuOpened="InsertTarget_Opened"><MenuItem Header="(loading)"/></MenuItem>
                <MenuItem Header="Wait until target is visible" Tag="WaitTarget" SubmenuOpened="InsertTarget_Opened"><MenuItem Header="(loading)"/></MenuItem>
                <MenuItem Header="Wait until target has disappeared" Tag="WaitGone" SubmenuOpened="InsertTarget_Opened"><MenuItem Header="(loading)"/></MenuItem>
                <MenuItem Header="When target appears / disappears..." Click="InsertWhen_Click"/>
                <MenuItem Header="Send Discord message…" Click="InsertDiscord_Click"/>
                <Separator/>
                <MenuItem Header="Key press" Tag="key" Click="Insert_Click"/>
                <MenuItem Header="Left click" Tag="lclick" Click="Insert_Click"/>
                <MenuItem Header="Right click" Tag="rclick" Click="Insert_Click"/>
                <MenuItem Header="Mouse move" Tag="move" Click="Insert_Click"/>
                <MenuItem Header="Scroll down" Tag="down" Click="Insert_Click"/>
                <MenuItem Header="Scroll up" Tag="up" Click="Insert_Click"/>
                <MenuItem Header="Scroll left" Tag="left" Click="Insert_Click"/>
                <MenuItem Header="Scroll right" Tag="right" Click="Insert_Click"/>
            </MenuItem>
        </Menu>
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="12,10,12,12">
        <Border x:Name="ToolbarCard" Background="White" BorderBrush="#E3E6EB" BorderThickness="1" CornerRadius="14" Padding="12">
            <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.08" Color="#1F2937"/></Border.Effect>
            <Grid x:Name="ToolbarGrid">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <UniformGrid x:Name="MainButtons" Rows="1" Grid.Row="0" Grid.ColumnSpan="3">
                    <Button x:Name="RecBtn" Style="{StaticResource Rec}" Content="● Record" Click="Record_Click"/>
                    <Button x:Name="RecPauseBtn" Style="{StaticResource Big}" Content="⏸ Pause" Click="Pause_Click"/>
                    <Button x:Name="PlayBtn" Style="{StaticResource Play}" Content="▶ Play" Click="Play_Click"/>
                    <Button x:Name="StopBtn" Style="{StaticResource Stop}" Content="■ Stop" Click="Stop_Click"/>
                </UniformGrid>
                <DockPanel x:Name="SpeedRow" Grid.Row="1" Grid.ColumnSpan="3" Margin="3,8,3,0" LastChildFill="False">
                    <Button x:Name="EditorBtn" DockPanel.Dock="Right" Margin="0" Style="{StaticResource Soft}" Content="⤢ Editor" Click="Editor_Click" ToolTip="Show or hide the full editor: macros, targets, timeline, events, run log"/>
                    <Button x:Name="OptionsBtn" DockPanel.Dock="Right" Margin="14,0,8,0" Content="⚙ Options ▾" Click="Options_Click" ToolTip="Playback options, Discord, step-by-step"/>
                    <TextBlock DockPanel.Dock="Left" Text="Speed" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#6B7280"/>
                    <ComboBox x:Name="SpeedBox" DockPanel.Dock="Left" Width="70" SelectedIndex="2" VerticalContentAlignment="Center" SelectionChanged="Speed_Changed">
                        <ComboBoxItem Content="0.25×"/><ComboBoxItem Content="0.5×"/><ComboBoxItem Content="1×"/>
                        <ComboBoxItem Content="1.5×"/><ComboBoxItem Content="2×"/><ComboBoxItem Content="4×"/><ComboBoxItem Content="8×"/>
                    </ComboBox>
                    <TextBlock DockPanel.Dock="Left" Text="Loops" VerticalAlignment="Center" Margin="14,0,6,0" Foreground="#6B7280"/>
                    <TextBox x:Name="LoopsBox" DockPanel.Dock="Left" Text="1" Width="44" VerticalContentAlignment="Center" ToolTip="How many times to play. 0 = repeat until stopped"/>
                    <CheckBox x:Name="InfiniteBox" DockPanel.Dock="Left" Content="∞ Infinite" Margin="12,0,0,0" VerticalAlignment="Center" Click="Infinite_Click"
                              ToolTip="Repeat the macro until you stop it with the Stop hotkey or button."/>
                </DockPanel>
                <Border x:Name="StatusPill" Grid.Row="2" Grid.ColumnSpan="3" CornerRadius="8" Padding="10,6" Margin="3,10,3,0" Background="#F3F5F9">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers><DataTrigger Binding="{Binding Text.Length, ElementName=StatusText}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" Foreground="#374151"/>
                </Border>
            </Grid>
        </Border>
        <Border x:Name="OptionsPanel" Visibility="Collapsed" Margin="0,10,0,0" Background="White" BorderBrush="#E3E6EB" BorderThickness="1" CornerRadius="14" Padding="12,6,12,8">
            <StackPanel>
                <WrapPanel x:Name="OptionsStepRow" Margin="-3,0,0,2">
                    <Button x:Name="StepBtn" Content="⏭ Step" Click="Step_Click" ToolTip="Fire one event at a time. This sends real input to whatever is on screen."/>
                    <Button x:Name="PlaySelBtn" Content="▶ From selection" Click="PlayFromSel_Click"/>
                </WrapPanel>
                <UniformGrid x:Name="OptionChecks" Columns="2">
                    <CheckBox x:Name="AdaptBox" Content="Adapt to this PC" IsChecked="True" VerticalAlignment="Center" Margin="2,4"
                              ToolTip="Remap positions to this PC's monitors and resolution, and match scroll distance to this PC's Windows scroll-lines setting. Off = replay raw recorded values."/>
                    <CheckBox x:Name="DynamicPathBox" Content="Mouse path follows moved targets" IsChecked="True" VerticalAlignment="Center" Margin="2,4" Click="DynamicPath_Click"
                              ToolTip="On: adaptive clicks bend the recorded mouse path to the target's new position (or glide to it), as set per step. Off: the recorded path is replayed exactly, then the cursor jumps to the target. The recording is never changed either way."/>
                    <CheckBox x:Name="ShowPathsBox" Content="Show paths while playing" IsChecked="False" Click="PathsOptions_Click" VerticalAlignment="Center" Margin="2,4"
                              ToolTip="Draws the recorded mouse path (blue, dashed) and the optimized path the mouse actually takes (orange, semi-transparent) over the screen during playback. Click-through and invisible to detection."/>
                    <CheckBox x:Name="CapturablePathsBox" Content="Overlays visible in recordings" IsChecked="False" Click="PathsOptions_Click" VerticalAlignment="Center" Margin="2,4"
                              ToolTip="On: the mouse paths and the detection boxes (Live detect and while playing) also show in screenshots, screen recordings and screen sharing, and in Discord screenshots. The boxes are drawn just outside the target, but a line crossing a target can slightly lower its match score. Off: hidden from every capture (and from the detector)."/>
                    <CheckBox x:Name="KeepVisibleBox" Content="Keep this window visible while playing" VerticalAlignment="Center" Margin="2,4"
                              ToolTip="Don't minimise while a macro plays, so you can watch the timeline, status and run log live. Clicking or scrolling in this window never stops the macro and never takes focus from the target app; the window is hidden from screen capture and lets replayed clicks pass through it."/>
                    <CheckBox x:Name="PauseOnUserBox" Content="Pause if I use the mouse or keyboard" VerticalAlignment="Center" Margin="2,4"
                              ToolTip="While a macro plays, pause as soon as you move the mouse or press a key yourself (the hotkeys are ignored). Resume with the Pause hotkey."/>
                    <CheckBox Content="Always on top" Click="TopMost_Click" VerticalAlignment="Center" Margin="2,4" ToolTip="Keep this window above other windows."/>
                </UniformGrid>
                <Border Height="1" Background="#E8EBF0" Margin="0,4,0,6"/>
                <WrapPanel>
                    <TextBlock Text="Discord" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center" Margin="2,0,10,0"/>
                    <Button x:Name="DiscordBtn" Margin="0,2,6,2" Content="Link for this recording…" Click="Discord_Click"
                            ToolTip="The webhook this recording sends to. It is stored privately on this PC (not in the recording) and is never included when you export."/>
                    <Button x:Name="DiscordDefaultBtn" Margin="0,2,12,2" Content="Default link…" Click="DiscordDefault_Click"
                            ToolTip="Used by every recording that has no link of its own."/>
                    <CheckBox x:Name="DiscordEndBox" Content="Message Discord when a macro ends" VerticalAlignment="Center" Margin="2,4,12,4" Click="DiscordEnd_Click"
                              ToolTip="Sends one short message (macro name, finished / stopped, warnings) to the recording's link every time a playback ends."/>
                    <CheckBox x:Name="DiscordShotBox" Content="+ screenshot" IsChecked="True" VerticalAlignment="Center" Margin="2,4,12,4" Click="DiscordEnd_Click"
                              ToolTip="Attach a screenshot of all monitors to the end-of-macro message."/>
                    <TextBlock x:Name="DiscordInfo" VerticalAlignment="Center" Foreground="#6B7280" Margin="2,0,0,0"/>
                </WrapPanel>
                <Border Height="1" Background="#E8EBF0" Margin="0,4,0,6"/>
                <WrapPanel>
                    <TextBlock Text="Hotkeys" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center" Margin="2,0,10,0"/>
                    <Button x:Name="HkRecord" Tag="record" Click="Hotkey_Click" Padding="9,3" Margin="2" ToolTip="Click, then press the new key or combination (for example Ctrl+Shift+Alt+R)"/>
                    <Button x:Name="HkPlay" Tag="play" Click="Hotkey_Click" Padding="9,3" Margin="2" ToolTip="Click, then press the new key or combination (for example Ctrl+Shift+Alt+R)"/>
                    <Button x:Name="HkPause" Tag="pause" Click="Hotkey_Click" Padding="9,3" Margin="2" ToolTip="Click, then press the new key or combination (for example Ctrl+Shift+Alt+R)"/>
                    <Button x:Name="HkStop" Tag="stop" Click="Hotkey_Click" Padding="9,3" Margin="2" ToolTip="Click, then press the new key or combination (for example Ctrl+Shift+Alt+R)"/>
                    <Button x:Name="HkPaths" Tag="paths" Click="Hotkey_Click" Padding="9,3" Margin="2" ToolTip="Click, then press the new key or combination (for example Ctrl+Shift+Alt+R)"/>
                    <Button Content="Reset" Click="HotkeyReset_Click" Padding="9,3" Margin="2,2,2,2" ToolTip="Back to F9 / F10 / F11 / F8 / F12"/>
                </WrapPanel>
            </StackPanel>
        </Border>
        </StackPanel>

<Border x:Name="PerfBar" Visibility="Collapsed" DockPanel.Dock="Bottom" Background="White" BorderBrush="#E3E6EB" BorderThickness="0,1,0,0" Padding="16,4">            <TextBlock x:Name="PerfText" FontFamily="Consolas" FontSize="11" Foreground="#6B7280"/>        </Border>
        <Grid x:Name="Editor" Visibility="Collapsed" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#E3E6EB" BorderThickness="1" CornerRadius="12" Padding="0,0,0,2">
            <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="110"/><RowDefinition Height="Auto"/><RowDefinition Height="1.4*" MinHeight="170"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <DockPanel x:Name="LibHeader" DockPanel.Dock="Top" Margin="0,8,0,2" Background="Transparent" AllowDrop="True" DragOver="LibHeader_DragOver" DragLeave="LibHeader_DragLeave" Drop="LibHeader_Drop" ToolTip="Drop macros here to move them out of their folders, back to the top of the list">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,6,0">
                        <Button Style="{StaticResource IconSm}" Content="&#xE710;" Click="NewMacro_Click" ToolTip="New macro"/>
                        <Button Style="{StaticResource IconSm}" Content="&#xE8C8;" Click="LibDuplicate_Click" ToolTip="Duplicate the selected macro"/>
                        <Button Style="{StaticResource IconSm}" Content="&#xE70F;" Click="LibRename_Click" ToolTip="Rename the selected macro"/>
                        <Button Style="{StaticResource IconSmDanger}" Content="&#xE74D;" Click="LibDelete_Click" ToolTip="Delete the selected macro"/>
                    </StackPanel>
                    <TextBlock Text="Macros" Margin="12,0,0,0" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox x:Name="LibList" Padding="0,4,0,40" IsKeyboardFocusWithinChanged="LibList_FocusWithin" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True" DragOver="LibList_DragOver" DragLeave="LibList_DragLeave" Drop="LibList_Drop" SelectionMode="Extended" KeyDown="LibList_KeyDown" PreviewMouseLeftButtonDown="LibList_PreviewDown" PreviewMouseMove="LibList_PreviewMove" PreviewMouseLeftButtonUp="LibList_PreviewUp" PreviewMouseRightButtonDown="LibList_PreviewRightDown" ToolTip="Click a macro to open it. Ctrl+click / Shift+click selects several. Drag macros onto another macro to put them inside it (it becomes a folder); drag them onto empty space to take them out. Ctrl+C copies. Ctrl+V pastes the macro alone, Ctrl+Shift+V pastes it with the macros inside it (right-click has both). With another macro selected the copy goes inside it, otherwise it appears next to the original." SelectionChanged="Lib_SelectionChanged" HorizontalContentAlignment="Stretch">
                    <ListBox.ContextMenu>
                        <ContextMenu Opened="LibMenu_Opened">
                            <MenuItem x:Name="LibMenuCopy" Header="Copy" InputGestureText="Ctrl+C" Click="LibCopy_Click"/>
                            <Separator/>
                            <MenuItem x:Name="LibMenuPaste" Header="Paste the macro only" InputGestureText="Ctrl+V" Click="LibPaste_Click" ToolTip="One new macro file: a copy of the copied macro without the macros inside it"/>
                            <MenuItem x:Name="LibMenuPasteSubs" Header="Paste with its sub macros" InputGestureText="Ctrl+Shift+V" Click="LibPasteSubs_Click" ToolTip="A copy of the copied macro and of every macro inside it"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,1" MinHeight="22" Background="Transparent">
                                <!-- folder contents hang off a thin guide line -->
                                <Border DockPanel.Dock="Left" Width="{Binding IndentPx}">
                                    <Border Width="1" HorizontalAlignment="Right" Margin="0,-8,10,-8" Background="#D5DBE5">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Nested}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    </Border>
                                </Border>
                                <!-- the arrow opens / closes a folder -->
                                <TextBlock DockPanel.Dock="Left" Tag="arrow" Text="{Binding Chevron}" Width="18" TextAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#6B7280" Background="Transparent" VerticalAlignment="Center" Cursor="Hand" ToolTip="Open / close this folder"/>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Width="22" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#94A3B8"/><Style.Triggers><DataTrigger Binding="{Binding HasKids}" Value="True"><Setter Property="Foreground" Value="#D97706"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <!-- a folder shows how many macros it holds, a plain macro shows its date -->
                                <Border DockPanel.Dock="Right" CornerRadius="9" Background="#EEF2FF" Padding="7,0,7,1" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Macros inside this folder">
                                    <TextBlock Text="{Binding Kids}" FontSize="10.5" FontWeight="SemiBold" Foreground="#3730A3"/>
                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasKids}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Modified, StringFormat='{}{0:MMM d}'}" FontSize="10.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#9CA3AF"/><Style.Triggers><DataTrigger Binding="{Binding HasKids}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Normal"/><Style.Triggers><DataTrigger Binding="{Binding HasKids}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <GridSplitter Grid.Row="1" Height="7" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Border x:Name="TargetsHost" Grid.Row="2" BorderBrush="#E8EBF0" BorderThickness="0,1,0,0"/>
            </Grid></Border>
            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

            <Border Grid.Column="2" Background="White" BorderBrush="#E3E6EB" BorderThickness="1" CornerRadius="12"><Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.6*" MinHeight="170"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="BottomRow" Height="1.4*" MinHeight="100"/>
                </Grid.RowDefinitions>
                <Border x:Name="PathHost" Grid.Row="0" Background="White"/>
                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#E3E6EB"/>
                <DockPanel Grid.Row="2" Background="White">
                    <Border DockPanel.Dock="Top" Padding="8,3" BorderBrush="#E8EBF0" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TlStepBtn" Content="⏭ Step" Click="Step_Click" Padding="10,3" Margin="2" ToolTip="Fire one event at a time. This sends real input to whatever is on screen."/>
                            <Button x:Name="TlPlaySelBtn" Content="▶ From selection" Click="PlayFromSel_Click" Padding="10,3" Margin="2" ToolTip="Play from the selected event"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="TimelineHost" Background="White"/>
                </DockPanel>
                <GridSplitter x:Name="BottomSplitter" Grid.Row="3" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#E3E6EB"/>
                <Grid Grid.Row="4">
                <TabControl x:Name="BottomTabs" Background="White" BorderThickness="0" Padding="0" PreviewMouseLeftButtonDown="BottomTabs_Click">
                    <TabItem Header="Events">
                        <DockPanel Background="White">
                            <Border DockPanel.Dock="Top" Padding="14,7" BorderBrush="#E8EBF0" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Foreground="#374151"/>
                                    <TextBlock x:Name="ProblemLink" Visibility="Collapsed" VerticalAlignment="Center" Margin="10,0,0,0" Cursor="Hand" FontWeight="SemiBold" Foreground="#B45309" TextDecorations="Underline" MouseLeftButtonDown="ProblemLink_Click"/>
                                    <Border x:Name="WhenChip" Margin="16,0,0,0" Padding="10,2,10,3" CornerRadius="10" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center"
                                            ToolTip="Drag into the event list (or click to add at the playhead): when a visual target appears or disappears, run a connected macro, restart or continue"
                                            PreviewMouseLeftButtonDown="WhenChip_Down" PreviewMouseMove="WhenChip_Move" PreviewMouseLeftButtonUp="WhenChip_Up">
                                        <TextBlock Text="&#x25C6; When target..." FontSize="11.5" FontWeight="SemiBold" Foreground="#92400E"/>
                                    </Border>
                                    <CheckBox x:Name="HideMovesBox" Content="Hide mouse moves" Margin="16,0,0,0" VerticalAlignment="Center" Click="HideMoves_Click"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="GridHost">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy" InputGestureText="Ctrl+C" Click="Copy_Click"/>
                                        <MenuItem Header="Paste at playhead" InputGestureText="Ctrl+V" Click="Paste_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Delete" InputGestureText="Del" Click="Delete_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                            </Border>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Run log" x:Name="LogTab">
                        <DockPanel Background="White">
                            <Border DockPanel.Dock="Top" Padding="14,9" BorderBrush="#E8EBF0" BorderThickness="0,0,0,1" Background="#F8FAFC">
                                <TextBlock x:Name="DebugText" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Foreground="#374151"
                                           Text="Debugger: press Step (or set a breakpoint with Ctrl+B) to run one event at a time. Details of the next action show here."/>
                            </Border>
                            <ListBox x:Name="LogList" BorderThickness="0" FontFamily="Consolas" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Detections" x:Name="DetectTab">
                        <ListBox x:Name="DetectList" BorderThickness="0" FontFamily="Consolas" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    </TabItem>
                </TabControl>
                <Button x:Name="CollapseBtn" Style="{StaticResource IconSm}" Content="&#xE70D;" Click="CollapseBottom_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,8,0"
                        ToolTip="Fold the panel away (only the tabs stay). Click a tab to open it again."/>
                </Grid>
            </Grid></Border>

            <GridSplitter Grid.Column="3" Width="10" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>
            <Border x:Name="InspectorHost" Grid.Column="4" Background="White" BorderBrush="#E3E6EB" BorderThickness="1" CornerRadius="12"/>
        </Grid>
    </DockPanel>
    </Border>
    </Grid>
</Window>
